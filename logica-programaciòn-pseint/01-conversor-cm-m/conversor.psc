Algoritmo ConvertirDistancia
	Definir kilometros, metros, centimetros Como Real
	Escribir "Ingrese la distancia en kilómetros: "
	Leer kilometros
	metros <- kilometros * 1000
	centimetros <- metros * 100
	Escribir "Distancia en metros: ", metros
	Escribir "Distancia en centímetros: ", centimetros
FinAlgoritmo